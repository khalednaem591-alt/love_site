<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رسالة سرية</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ff758c, #ff7eb3);
            font-family: Arial, sans-serif;
            overflow: hidden;
        }

        .box {
            width: 85%;
            max-width: 400px;
            padding: 30px;
            text-align: center;
            background: rgba(255,255,255,0.95);
            border-radius: 25px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        }

        h2 {
            color: #ff3f68;
        }

        input {
            width: 90%;
            padding: 14px;
            border: 2px solid #ff9ab0;
            border-radius: 12px;
            outline: none;
            text-align: center;
            font-size: 17px;
        }

        button {
            width: 95%;
            padding: 14px;
            margin-top: 15px;
            border: none;
            border-radius: 12px;
            background: #ff3f68;
            color: white;
            font-size: 17px;
            cursor: pointer;
        }

        #message {
            display: none;
            color: #ff3f68;
            font-size: 25px;
            animation: appear 1s ease;
        }

        #error {
            color: #ff1744;
            margin-top: 15px;
            font-size: 18px;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: scale(0.5);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .heart {
            position: fixed;
            bottom: -30px;
            color: #fff;
            font-size: 25px;
            animation: float 5s linear forwards;
            pointer-events: none;
        }

        @keyframes float {
            from {
                transform: translateY(0);
                opacity: 1;
            }

            to {
                transform: translateY(-110vh);
                opacity: 0;
            }
        }
    </style>
</head>

<body>

    <div class="box">

        <div id="login">
            <h2>🔐 كلمة السر</h2>

            <input
                type="text"
                id="password"
                placeholder="اكتبي كلمة السر"
            >

            <button onclick="checkPassword()">
                دخول
            </button>

            <div id="error"></div>
        </div>

        <div id="message">
            انا عمك خالد بحبك يمرا
        </div>

    </div>

    <script>

        const correctPassword = "انا كلبه";

        function checkPassword() {

            const password =
                document.getElementById("password").value.trim();

            if (password === correctPassword) {

                document.getElementById("login").style.display = "none";

                document.getElementById("message").style.display = "block";

                createHearts();

            } else {

                document.getElementById("error").textContent =
                    "انتي كلبه يمتخلفه";

            }
        }

        function createHearts() {

            for (let i = 0; i < 25; i++) {

                const heart = document.createElement("div");

                heart.className = "heart";
                heart.textContent = "♥";

                heart.style.left =
                    Math.random() * 100 + "vw";

                heart.style.fontSize =
                    (15 + Math.random() * 25) + "px";

                heart.style.animationDuration =
                    (3 + Math.random() * 4) + "s";

                document.body.appendChild(heart);

                setTimeout(() => {
                    heart.remove();
                }, 7000);
            }
        }

    </script>

</body>
</html>